// Cloudflare (Workers + fichiers statiques) : publie le build de l'application.
// Dans Cloudflare : Build command = npm run build -w @hc/admin
//                   Deploy command = npx wrangler deploy --config apps/admin/wrangler.jsonc
// "name" doit être identique au nom du projet créé dans Cloudflare.
{
  "name": "houcine-chapati-admin",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist"
  }
}

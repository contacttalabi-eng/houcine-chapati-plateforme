# =============================================================================
# Houcine Chapati — variables d'environnement
# Copier ce fichier en ".env" (jamais commité) puis remplir les valeurs.
# Un seul fichier .env sert aux 3 applications (client, admin, livreur).
# =============================================================================

# --- Supabase (Project Settings → API Keys / Data API) -----------------------
# URL du projet : https://<ref>.supabase.co
VITE_SUPABASE_URL=
# Clé PUBLIQUE uniquement : "publishable key" (sb_publishable_...) ou, sur les
# anciens projets, la clé "anon". Elle est faite pour le navigateur : la sécurité
# repose sur la RLS. NE JAMAIS mettre ici la clé secrète / service_role.
VITE_SUPABASE_ANON_KEY=

# --- Google Maps Platform ----------------------------------------------------
# Clé navigateur RESTREINTE (référents HTTP = vos domaines + API autorisées :
# Maps JavaScript API, Routes API). Elle est visible dans le navigateur par
# nature : la protection vient des restrictions configurées dans Google Cloud.
VITE_GOOGLE_MAPS_API_KEY=
# Map ID (Google Cloud → Map Management) requis pour les marqueurs avancés.
# Laisser vide en développement pour utiliser DEMO_MAP_ID.
VITE_GOOGLE_MAPS_MAP_ID=

# --- Test de bout en bout (npm run e2e) — facultatif, jamais dans le front ---
# Comptes de test créés dans Supabase (voir README § Comptes).
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_DRIVER_EMAIL=
E2E_DRIVER_PASSWORD=
